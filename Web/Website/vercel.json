{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; media-src 'self'; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests"
        },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "key": "Permissions-Policy",
          "value": "accelerometer=(), browsing-topics=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), hid=(), magnetometer=(), microphone=(), midi=(), payment=(), serial=(), usb=()"
        },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" }
      ]
    }
  ],
  "redirects": [
    { "source": "/privacy-policy", "destination": "/privacy/", "permanent": true },
    { "source": "/privacy-policy/", "destination": "/privacy/", "permanent": true },
    { "source": "/terms-of-use", "destination": "/terms/", "permanent": true },
    { "source": "/terms-of-use/", "destination": "/terms/", "permanent": true },
    { "source": "/contact", "destination": "/support/", "permanent": true },
    { "source": "/contact/", "destination": "/support/", "permanent": true },
    { "source": "/security.txt", "destination": "/.well-known/security.txt", "permanent": true }
  ]
}
